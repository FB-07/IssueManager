APP_NAME=IssueManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://issuemanager.test

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=issuemanager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=IssueManager

# Claude (Anthropic Messages API) - key stays on the server
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# YouTrack (permanent token stays on the server; leave empty to run with the simulated tracker)
YOUTRACK_URL=https://your-company.youtrack.cloud
YOUTRACK_TOKEN=
YOUTRACK_TITLE_PREFIX=

# Login with the YouTrack Hub (OAuth 2.0). Redirect URI to register: ${APP_URL}/auth/youtrack/callback
YOUTRACK_CLIENT_ID=
YOUTRACK_CLIENT_SECRET=
# Optional: must equal the Redirect URI registered in the Hub service. Defaults to APP_URL + /auth/youtrack/callback
# YOUTRACK_REDIRECT_URI=

# Local development only (ignored outside APP_ENV=local)
# Only Hub accounts with one of these email domains can sign in (their user is created on first login); comma separated
AUTH_ALLOWED_DOMAIN=proside.pt,empirepuzzle.com
AUTH_DEV_LOGIN=false
YOUTRACK_SCOPES="0-0-0-0-0 717cc203-b497-4829-9374-5405163d90e3"
